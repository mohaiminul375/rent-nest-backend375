model User {
    id        String     @id @default(uuid())
    name      String
    email     String     @unique
    password  String
    phone     String
    role      UserRole
    status    UserStatus @default(UNBANNED)
    address   String?
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    properties     Property[]
    rentalRequests RentalRequest[]
    // @relation("TenantRentalRequests")
    payment        Payment?

    @@index([role])
    @@index([status])
    @@index([email])
    @@map("users")
}
